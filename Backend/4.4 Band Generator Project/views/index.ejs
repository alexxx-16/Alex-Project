<%- include("partials/header.ejs") %>

<% if(locals.adj && locals.noun){ %>
<h1>Your band name is <%= adj %> <%= noun %></h1>
<% } else { %>
  <h1> Click to generate your band name 🎸</h1>
<% } %>
<form action="/submit" method="POST">
  <input type="submit" value= "<%= locals.adj && locals.noun? 'Try Again' : 'Generate Name' %>"/>
</form>

<%- include("partials/footer.ejs") %>